# Copy to .env and fill in. Required values have no safe default and the addon
# fails fast on startup if they are missing.

# ---- required ----
# HMAC secret for signing /play URLs. Generate a strong random value, e.g.:
#   openssl rand -base64 32
SIGNING_SECRET=

# Prowlarr search API. PROWLARR_URL should be reachable from inside the
# container (use the internal Docker service name / host).
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# ---- recommended ----
# External hostname used to build install + /play URLs (no scheme needed).
# If unset, the addon falls back to the incoming request's Host header.
PUBLIC_HOST=torrserver.example.com

# ---- optional (defaults shown) ----
# Addon listen port (only this port should be reverse-proxied).
PORT=7000

# Internal TorrServer URL. Leave as-is for the bundled sibling process.
TORRSERVER_URL=http://127.0.0.1:8090

# Set true if PROWLARR_URL is HTTPS with a private/internal CA that the
# container doesn't trust. Prefer an internal http:// URL when possible.
PROWLARR_INSECURE_TLS=false

# Cinemeta metadata service.
CINEMETA_URL=https://v3-cinemeta.strem.io

# SQLite path (users, config, caches). Keep on the mounted /data/addon volume.
DB_PATH=/data/addon/addon.db

# Signed /play URL lifetime.
PLAY_URL_TTL=6h

# Cache TTLs.
PROWLARR_CACHE_TTL=12h
CINEMETA_CACHE_TTL=720h

# Preload a little from TorrServer before returning streams.
TORRSERVER_PRELOAD=true

# Remove torrents from TorrServer after this much idle time.
TORRENT_IDLE_TTL=30m
